# Optional: enables OpenAI embeddings (text-embedding-3-small) and, if
# ANTHROPIC_API_KEY is unset, GPT answers.
OPENAI_API_KEY=

# Optional: enables Claude answers. Takes priority over OpenAI for generation.
ANTHROPIC_API_KEY=

# --- Overrides (defaults shown) ---
# RAG_CHUNK_SIZE=900
# RAG_CHUNK_OVERLAP=150
# RAG_TOP_K=4
# RAG_MAX_FILE_SIZE_MB=20
# RAG_HISTORY_TURNS=3
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# ANTHROPIC_MODEL=claude-sonnet-5
# SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2
